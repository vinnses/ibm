# Copy this file to the project-local .env and store real values only there.
# The .env file is ignored by Git and should remain mode 0600.

# Local-only host bindings and ports.
WEB_BIND=127.0.0.1
WEB_PORT=5173
CODE_BIND=127.0.0.1
CODE_PORT=8080

# Required. Replace this safe example with a long random local secret.
CODE_SERVER_PASSWORD=replace-with-a-long-random-local-secret

# Optional Tailscale auth key. Leave empty to authenticate interactively.
# Generate a reusable, non-ephemeral key if the named volume must retain a
# stable node identity across container recreation.
TS_AUTHKEY=

# Optional arguments passed to `tailscale up`, for example an approved tag.
TS_EXTRA_ARGS=
